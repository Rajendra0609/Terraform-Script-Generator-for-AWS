# =============================================================================
# TFGen — Root .env for `docker compose up` (project root, next to
# docker-compose.yml). Copy this file to `.env` in the SAME directory and
# fill in every value below before starting.
# =============================================================================
#
# SECURITY CONTEXT — read before filling this in:
# This file did not exist before the C-06/C-09/C-10 security-audit fixes.
# docker-compose.yml previously fell back to hardcoded weak defaults for
# every value below whenever this file was absent — a weak Postgres password
# (`tfgen123`), a completely unauthenticated Redis, and a backend that would
# start up fine using a publicly-known JWT secret embedded in the source.
# None of those fallbacks exist anymore: `docker compose up` will now refuse
# to start with a clear error if any REQUIRED variable below is missing.
# Never commit the real `.env` file — it's already covered by .gitignore.
# =============================================================================

# ── Postgres (required — no default) ──────────────────────────────────────────
POSTGRES_USER=tfgen
POSTGRES_PASSWORD=                      # REQUIRED — generate: openssl rand -hex 24
POSTGRES_DB=terraform_generator

# ── Redis (required — no default) ─────────────────────────────────────────────
REDIS_PASSWORD=                         # REQUIRED — generate: openssl rand -hex 24

# ── JWT (required — no default, backend refuses to start without these) ──────
# See backend/middleware/auth.js — fails fast at startup if unset, still the
# old insecure literal, or shorter than 32 characters.
JWT_SECRET=                             # REQUIRED — generate: openssl rand -hex 32
JWT_REFRESH_SECRET=                     # REQUIRED — generate: openssl rand -hex 32 (must differ from JWT_SECRET)

# ── AES-256-GCM key for encrypting stored AWS credentials (required) ─────────
# See backend/utils/awsCrypto.js — same fail-fast pattern as JWT above.
ENCRYPT_KEY=                            # REQUIRED — generate: openssl rand -hex 32

# ── CORS / frontend origin ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Ports published to the HOST ───────────────────────────────────────────────
# Only the frontend (nginx) is published by default — see docker-compose.yml
# SECURITY FIX comments for why postgres/redis/backend are no longer
# published directly to the host.
FRONTEND_PORT=3000

# ── GitHub / Google sign-in (optional — leave blank to hide those buttons) ───
# THESE VARIABLES WERE PREVIOUSLY MISSING FROM THIS FILE. docker-compose.yml
# loads the backend's environment from THIS file (env_file), not from
# backend/.env.example/.env — so setting these only in backend/.env has no
# effect on `docker compose up`, and the OAuth buttons will 501 as
# "not configured" until they are set here too.
#
# BUG-OAUTH-01 — "the sign-in redirect is currently blocked": the missing
# variables above were one half of this; the other half was
# OAUTH_REDIRECT_BASE. That value is the origin the USER'S BROWSER lands on
# after Google/GitHub redirects back, which in this docker-compose topology
# is nginx's published origin (FRONTEND_PORT) — NOT the backend container's
# own port 4000, since that port is deliberately not published to the host
# (see the C-10 fix noted above). Getting this backwards means the provider
# redirects the browser straight at a port nothing on the host is listening
# on, which looks exactly like a hang/block after you approve access.
# docker-compose.yml now defaults this correctly for you (derived from
# FRONTEND_PORT below); override it only if you're serving this over a real
# domain (e.g. https://tfgen.example.com) instead of localhost.
OAUTH_REDIRECT_BASE=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
#   https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origin : ${FRONTEND_URL} (http://localhost:3000)
#   Authorized redirect URI      : ${OAUTH_REDIRECT_BASE}/api/auth/oauth/google/callback
#                                  (http://localhost:3000/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
#   https://github.com/settings/developers
#   Homepage URL              : ${FRONTEND_URL} (http://localhost:3000)
#   Authorization callback URL: ${OAUTH_REDIRECT_BASE}/api/auth/oauth/github/callback
#                                (http://localhost:3000/api/auth/oauth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Deploying on a real domain instead of localhost? Update ALL FOUR of
# FRONTEND_URL, CORS_ORIGIN, OAUTH_REDIRECT_BASE above and the two provider
# console entries to the same https://your-domain.com — every one of these
# must agree exactly (scheme + host + port) or sign-in will fail either with
# a blocked/unreachable redirect (mismatch between OAUTH_REDIRECT_BASE and
# what's actually published) or a provider-side "redirect_uri_mismatch"
# error (mismatch between OAUTH_REDIRECT_BASE and the provider console).

# ── First-admin bootstrap (optional) ──────────────────────────────────────────
# Sets an org-wide one-time token that lets ONE registration request include
# `"adminBootstrap": "<this value>"` to receive the admin role — see
# backend/routes/auth.js. Leave blank to disable this entirely (recommended
# once you have your first admin) or use `node scripts/create-admin.js`
# instead, which never touches the network.
ADMIN_BOOTSTRAP_TOKEN=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Comma-separated exact IPs or CIDR ranges (e.g. 127.0.0.1,::1,10.0.0.0/8)
# exempted from rate limiting. Leave at the default unless you have a real
# reason to trust a wider range — this is now exact/CIDR-matched (see
# server.js C-10 fix), not substring-matched, so it's safe to be specific.
RATE_LIMIT_TRUSTED_IPS=127.0.0.1,::1
TRUST_PROXY=1

# ── Email (nodemailer / SMTP) — optional, leave blank to disable email ───────
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── AI features — optional ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Observability: metrics, logs, tracing ─────────────────────────────────────
# Structured JSON logs (with timestamps and a correlation ID per request) and
# a Prometheus /metrics endpoint are always on — nothing to configure. See
# backend/server.js, backend/observability/metrics.js and
# backend/middleware/requestLogger.js.
LOG_LEVEL=info

# Distributed tracing (OpenTelemetry) is opt-in — off by default since no
# collector ships in the base docker-compose.yml. Run
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up
# for a ready-to-go Jaeger + Prometheus + Grafana stack, then set:
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_TRACES_SAMPLER_RATIO=1

# Internal-only port serving GET /metrics in Prometheus exposition format.
# Not published to the host and not proxied by nginx on purpose — see
# backend/observability/metrics.js for why. Only other containers on this
# compose network (e.g. the "prometheus" service added by
# docker-compose.observability.yml, which scrapes backend:9464) can reach it.
METRICS_PORT=9464

# ── Added in 0.0.4 ─────────────────────────────────────────────────────────────
# Require an approved change request before `terraform apply` (recommended for production).
APPLY_REQUIRES_APPROVAL=false
# GitHub integration. Override the API base for GitHub Enterprise Server only.
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_MS=15000
