# ─── TFGen root .env.example ──────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Add .env to .gitignore — never commit secrets to version control.
#
# Generate each secret with:
#   openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# JWT signing secret (access tokens, min 32 chars)
JWT_SECRET=replace_with_openssl_rand_hex_32

# JWT signing secret for refresh tokens (must differ from JWT_SECRET)
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_hex_32

# AES-256-GCM encryption key for stored AWS credentials (must be exactly 32 bytes)
ENCRYPT_KEY=replace_with_openssl_rand_hex_32

# Optional: override the Terraform Language Server executable path used by the
# backend. If unset, the backend will use `terraform-ls` from PATH.
# TF_LSP_PATH=terraform-ls
