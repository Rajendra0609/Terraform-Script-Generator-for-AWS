pipeline {
    agent {
        kubernetes {
            label 'kube_m'
            defaultContainer 'jnlp'
        }
    }
    tools {
        nodejs 'nodejs'
    }
    triggers {
        pollSCM('H/5 * * * *')
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '1'))
        disableConcurrentBuilds()
        timeout(time: 1, unit: 'HOURS')
        skipDefaultCheckout()
        timestamps()
        disableResume()
        retry(1)
        preserveStashes(buildCount: 10)
        quietPeriod(5)
        lock(resource: 'prod-deploy')
        checkoutToSubdirectory('source')
    }
    environment {
        DOCKER_HUB_CREDENTIALS_ID = 'docker'
        GIT_BRANCH                = "${params.GIT_BRANCH}"
        GITHUB_CREDENTIALS_ID     = 'github'
        GITHUB_REPO               = 'Rajendra0609/Terraform-Script-Generator-for-AWS'
        GITHUB_API_URL            = 'https://api.github.com'
        EMAIL_RECIPIENTS          = 'rajendra.daggubati09@gmail.com,srirajendraprasaddaggubati@gmail.com'
        TERM                      = 'xterm-256color'
        GITHUB_TOKEN              = 'git_token'
        DOCKER_USER               = 'docker_user'
        DOCKER_PASS               = 'docker_token'
        SCANNER_HOME              = tool 'sonar'
        // Composed image tag used across Docker stages
        IMAGE_TAG                 = "${params.DOCKERHUBREPO}:${params.VERSION}"
        BACKEND_TEST_PORT = '4099'
        FRONTEND_URL      = 'http://localhost:3000'

        // ── Test credentials (override from Jenkins credentials store) ─────────
        TEST_DATABASE_URL = credentials('TEST_DATABASE_URL')
        TEST_REDIS_URL    = credentials('TEST_REDIS_URL')
        JWT_SECRET        = credentials('TFGEN_TEST_JWT_SECRET')
        ENCRYPT_KEY       = credentials('TFGEN_TEST_ENCRYPT_KEY')

        // ── Node / npm ─────────────────────────────────────────────────────────
        NODE_ENV          = 'test'
        CI                = 'true'
        NPM_CONFIG_CACHE  = "${WORKSPACE}/.npm-cache"

        // ── Reports ────────────────────────────────────────────────────────────
        REPORT_DIR        = "${WORKSPACE}/tests/reports"

        // ── Playwright ────────────────────────────────────────────────────────
        PLAYWRIGHT_BROWSERS_PATH = "${WORKSPACE}/.playwright-browsers"
    }
    parameters {
        string(name: 'GIT_BRANCH',               defaultValue: 'docker_test',                         description: 'Branch to build')
        string(name: 'DOCKERHUBREPO',            defaultValue: 'daggu1997/terraform-script-generator',    description: 'Docker Hub repository to push the image')
        string(name: 'VERSION',                  defaultValue: 'v0.0.1',                          description: 'Version of the Docker image')
        string(name: 'DOCKER_HUB_CREDENTIALS_ID', defaultValue: 'docker',                        description: 'Credentials ID for Docker Hub')
        string(name: 'GITHUB_CREDENTIALS_ID',   defaultValue: 'github',                          description: 'Credentials ID for GitHub access')
        string(name: 'GITHUB_REPO',             defaultValue: 'Rajendra0609/Terraform-Script-Generator-for-AWS',     description: 'GitHub repository in owner/repo format')
        string(name: 'TAG',                     defaultValue: 'v0.0.1',                           description: 'Version of the Kubernetes deployment')
        string(name: 'EMAIL_RECIPIENTS',        defaultValue: 'rajendra.daggubati09@gmail.com,srirajendraprasaddaggubati@gmail.com', description: 'Comma-separated list of email recipients')
        string(name: 'K8S_NAMESPACE',           defaultValue: 'default',                          description: 'Kubernetes namespace for deployment')
        string(name: 'K8S_DEPLOYMENT_NAME',     defaultValue: 'terraform-script-generator',                  description: 'Kubernetes deployment name')
    }

    stages {

        stage('Checkout') {
            steps {
                echo '🔄 Cloning the code into source/'
                checkout scm: [
                    $class: 'GitSCM',
                    branches: [[name: "${params.GIT_BRANCH}"]],
                    extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: 'source']],
                    userRemoteConfigs: [[
                        url          : 'https://github.com/Rajendra0609/Terraform-Script-Generator-for-AWS.git',
                        credentialsId: 'github',
                        name         : 'origin'
                    ]]
                ]
                // Stash checked-out source so later stages can restore it if needed
                dir('source') {
                    stash name: 'source-code', includes: '**/*'
                }
            }
        }

        stage('Check Node Status') {
            steps {
                withCredentials([
                    string(credentialsId: 'github_token',  variable: 'GITHUB_TOKEN'),
                    usernamePassword(credentialsId: 'docker',
                                     usernameVariable: 'DOCKER_USER',
                                     passwordVariable: 'DOCKER_PASS')
                ]) {
                    script {
                        def status = sh(script: 'bash /usr/local/bin/node_status.sh', returnStdout: true).trim()
                        echo "Node Status Output:\n${status}"
                        if (status.contains("ERROR") || status.contains("DOWN")) {
                            error("Node status check failed: ${status}")
                        }
                    }
                }
            }
        }

        stage('Gitleaks Scan') {
            steps {
                dir('source') {
                    echo '🔍 Running Gitleaks...'
                    sh '''
                        gitleaks detect --source . --redact \
                            --report-format=json \
                            --report-path=../gitleaks-report.json
                    '''
                }
                archiveArtifacts artifacts: 'gitleaks-report.json', onlyIfSuccessful: false
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('Backend') {
                    steps {
                        dir('backend') {
                            echo '📦 Installing backend npm dependencies...'
                            sh 'npm install --cache ${NPM_CONFIG_CACHE}'
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            echo '📦 Installing frontend npm dependencies...'
                            sh 'npm install --cache ${NPM_CONFIG_CACHE}'
                        }
                    }
                }
            }
        }    

    } 
    post {
        success {
            echo '✅ Build & Deploy completed successfully!'
            slackSend(
                channel: '#doc_jen_task_tracker',
                message: """
                    ✅ *Pipeline Success*
                    *Job:* `${env.JOB_NAME}`
                    *Build #:* `${env.BUILD_NUMBER}`
                    *Image:* `${IMAGE_TAG}`
                    *Status:* Passed ✅
                    <${env.BUILD_URL}|View Build Logs>
                """
            )
            mail(
                to: "${EMAIL_RECIPIENTS}",
                subject: "SUCCESS: ${env.JOB_NAME} [#${env.BUILD_NUMBER}]",
                body: """\
                    The Jenkins Pipeline completed successfully.

                    🐳 Docker Image : ${IMAGE_TAG}
                    🔗 Pipeline URL : ${env.BUILD_URL}
                    👷 Triggered by : ${currentBuild.getBuildCauses()[0].userName}

                    View the full job here: ${env.BUILD_URL}
                """
            )
        }

        failure {
            script {
                def log         = currentBuild.rawBuild.getLog(1000)
                def lastLines   = log.takeRight(50).join('\n')
                def culprit     = "Unknown"
                def changeAuthor = "Unknown"

                try {
                    changeAuthor = currentBuild.changeSets.collect { cs ->
                        cs.items.collect { it.author.fullName }
                    }.flatten().unique().join(', ')
                    culprit = currentBuild.getBuildCauses()[0].userName
                } catch (e) {
                    echo "Failed to determine author or trigger: ${e.message}"
                }

                slackSend(
                    channel: '#doc_jen_task_tracker',
                    message: """
                        ❌ *Pipeline Failure*
                        *Job:* `${env.JOB_NAME}`
                        *Build #:* `${env.BUILD_NUMBER}`
                        *Status:* FAILED ❌
                        <${env.BUILD_URL}|View Build Logs>
                    """
                )
                mail(
                    to: "${EMAIL_RECIPIENTS}",
                    subject: "FAILURE: ${env.JOB_NAME} [#${env.BUILD_NUMBER}]",
                    body: """\
                        The Jenkins Pipeline has FAILED ❌

                        👤 Git Committer(s): ${changeAuthor}
                        🚀 Triggered by    : ${culprit}
                        🔗 Pipeline URL    : ${env.BUILD_URL}

                        📄 Last 50 lines of console output:
                        --------------------------------------------------
                        ${lastLines}
                        --------------------------------------------------

                        Please investigate the issue.
                    """
                )
            }
        }

        unstable {
            script {
                def log          = currentBuild.rawBuild.getLog(1000)
                def lastLines    = log.takeRight(50).join('\n')
                def culprit      = "Unknown"
                def changeAuthor = "Unknown"

                try {
                    changeAuthor = currentBuild.changeSets.collect { cs ->
                        cs.items.collect { it.author.fullName }
                    }.flatten().unique().join(', ')
                    culprit = currentBuild.getBuildCauses()[0].userName
                } catch (e) {
                    echo "Failed to determine author or trigger: ${e.message}"
                }

                slackSend(
                    channel: '#doc_jen_task_tracker',
                    message: """
                        ⚠️ *Pipeline Unstable*
                        *Job:* `${env.JOB_NAME}`
                        *Build #:* `${env.BUILD_NUMBER}`
                        *Status:* UNSTABLE ⚠️
                        <${env.BUILD_URL}|View Build Logs>
                    """
                )
                mail(
                    to: "${EMAIL_RECIPIENTS}",
                    subject: "UNSTABLE: ${env.JOB_NAME} [#${env.BUILD_NUMBER}]",
                    body: """\
                        The Jenkins Pipeline is UNSTABLE ⚠️

                        👤 Git Committer(s): ${changeAuthor}
                        🚀 Triggered by    : ${culprit}
                        🔗 Pipeline URL    : ${env.BUILD_URL}

                        📄 Last 50 lines of console output:
                        --------------------------------------------------
                        ${lastLines}
                        --------------------------------------------------

                        Please investigate the warning.
                    """
                )
            }
        }

        always {
            // Clean up locally built Docker image to free disk space
            sh "docker rmi ${IMAGE_TAG} || true"
            cleanWs()
            echo '🧹 Workspace cleaned'
        }
    }
}
