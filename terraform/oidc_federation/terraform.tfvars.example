# terraform/oidc_federation/terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars to git.

aws_region   = "ap-south-1"   # change to your region

github_org   = "your-github-username-or-org"
github_repo  = "tfgen"
github_branch = "main"        # use * to allow all branches

# Leave blank to skip IRSA (EKS pod identity)
eks_cluster_name    = ""      # e.g. "tfgen-prod"
k8s_namespace       = "tfgen"
k8s_service_account = "tfgen-worker"

# Optionally add managed policies for more permissions
tfgen_permissions = []
# Example: tfgen_permissions = ["arn:aws:iam::aws:policy/ReadOnlyAccess"]
