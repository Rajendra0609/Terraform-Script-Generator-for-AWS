# BUG FIX: this file did not exist at all — `COPY . .` in the Dockerfile was
# sending (and could bake into an image layer) local secrets and bloat.
node_modules
npm-debug.log*

# Never let a local secrets file end up in an image layer.
.env
.env.*
!.env.example

# VCS / editor / OS cruft
.git
.gitignore
.vscode
.idea
*.swp
.DS_Store

# Logs
logs
*.log

# Nothing test/doc related belongs in the runtime image
coverage
