PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://tfgen:tfgen123@localhost:5432/terraform_generator
# For local dev, leave CORS_ORIGIN unset (defaults to *).
# For production, set to your frontend URL:
# CORS_ORIGIN=http://localhost:3000

# ── Frontend URL (used in password-reset emails) ──────────────────────────────
# No trailing slash. Must be reachable by the end user (not the backend container).
FRONTEND_URL=http://localhost:3000

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Required for password-reset emails.
#
# Gmail quick-start:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to myaccount.google.com → Security → App passwords.
#   3. Generate an app password for "Mail".
#   4. Fill in the four values below.
#
# Other providers: adjust SMTP_HOST / SMTP_PORT to match (e.g. SendGrid, SES, Mailgun).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false        # set to true only for port 465 (SSL); leave false for 587 (STARTTLS)
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=TFGen <you@gmail.com>

# Optional: override the Terraform Language Server executable path used by Studio
# editor features. If `terraform-ls` is not on PATH, set the full filesystem path.
# TF_LSP_PATH=/usr/local/bin/terraform-ls

# ── AWS STS credential verification ───────────────────────────────────────────
# If the backend runs in an air-gapped network (e.g. a Kubernetes pod with no
# outbound internet), AWS STS will be unreachable and credential saves will fail
# with a 503. Use one of these options:
#
# Option A — skip verification entirely (credentials are stored without a
#   live STS call; use with caution, no format check is performed):
# SKIP_STS_VERIFY=true
#
# Option B — point to a VPC Interface Endpoint or HTTPS proxy for STS:
# AWS_STS_ENDPOINT=https://vpce-xxxxxxxxxxxx-xxxxxxxx.sts.ap-south-1.vpce.amazonaws.com
