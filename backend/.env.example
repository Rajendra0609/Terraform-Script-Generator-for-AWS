# =============================================================================
# TFGen Backend — Environment Variables (Phases 1-5)
# =============================================================================
# Copy this file to backend/.env and fill in real values.
# Never commit .env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development        # development | production
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false           # set to true behind nginx/ALB

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tfgen_user:changeme@localhost:5432/tfgen_db

# ── Redis (BullMQ job queue) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ──────────────────────────────────────────────────────────────────
# SECURITY: backend/middleware/auth.js now fails fast at startup (throws,
# process won't come up) if either secret below is unset, still equal to a
# known-insecure default, or shorter than 32 characters — there is no longer
# a hardcoded fallback to fall back to. Generate real values with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-at-least-48-chars
JWT_REFRESH_SECRET=another-long-random-secret-for-refresh-tokens
JWT_ACCESS_EXPIRY=15m       # short-lived access tokens
JWT_REFRESH_EXPIRY=7d
ENCRYPT_KEY=exactly-32-chars-for-aes-256-!!  # must be exactly 32 chars

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000   # frontend URL (comma-separated for multiple)
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:4000   # where THIS backend lives

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=200            # requests per window
RATE_LIMIT_TRUSTED_IPS=       # comma-separated IPs to exempt (e.g. 127.0.0.1)

# ── AWS credentials (Phase 5: prefer OIDC — set these only for local dev) ─────
# Production: use OIDC federation (terraform/oidc_federation/main.tf)
# Local dev only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1          # region used for the backend's own AWS SDK/STS calls — set to your operating region
DEFAULT_AWS_REGION=us-east-1  # fallback region for new projects/resources when the user doesn't pick one — set to your users' region
SKIP_STS_VERIFY=false        # set to true in local dev without real AWS access
AWS_STS_ENDPOINT=            # leave blank to use default regional endpoint

# ── Terraform execution ───────────────────────────────────────────────────────
TERRAFORM_PATH=/usr/local/bin/terraform  # path to terraform binary (if not Docker)
TF_DOCKER_IMAGE=hashicorp/terraform:1.7  # Docker image used for sandboxed runs
TF_LSP_PATH=                             # optional: terraform-ls binary for LSP
JOB_CONCURRENCY=3                        # max concurrent BullMQ workers

# ── Security scanning ─────────────────────────────────────────────────────────
CHECKOV_IMAGE=bridgecrew/checkov:latest  # Docker image for Checkov SAST
BLOCK_PLAN_ON_CRITICAL=true              # block plan when CRITICAL findings detected

# ── Cost estimation ───────────────────────────────────────────────────────────
INFRACOST_API_KEY=                       # get free key at https://www.infracost.io
INFRACOST_IMAGE=infracost/infracost:ci-0.10

# ── Phase 2: OPA Policy-as-Code ──────────────────────────────────────────────
OPA_PATH=/usr/local/bin/opa  # optional: path to OPA binary
                              # if absent, TFGen uses its pure-JS Rego evaluator
                              # install: https://www.openpolicyagent.org/docs/latest/#running-opa

# ── Phase 3: OAuth / SSO ─────────────────────────────────────────────────────
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: {OAUTH_REDIRECT_BASE}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: {OAUTH_REDIRECT_BASE}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI features (HCL Explainer + Studio AI code assistant) ────────────────────
# Anthropic API key — https://console.anthropic.com
# Powers two features:
#   1. Builder → "Learn" tab → Ask AI to Explain This Architecture (falls back
#      to a static knowledge-base explainer without this key)
#   2. Studio → ✨ AI Assistant sidebar → write/update code from an instruction
#      (returns a clear 503 without this key — there is no offline fallback
#      for code generation)
ANTHROPIC_API_KEY=

# ── Phase 4: Email notifications (nodemailer) ─────────────────────────────────
# SECURITY: a real Gmail address + App Password were previously committed
# directly into docker-compose.yml's `environment:` block. That password is
# burned — revoke it in Google Account → Security → App Passwords and issue a
# new one, then put ONLY the new value here (in a git-ignored .env), never in
# docker-compose.yml itself.
SMTP_USER=
SMTP_FROM=noreply@your-domain.com
# For Gmail: use App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASS=

# ── Docker Compose overrides (for docker-compose.yml) ────────────────────────
# These are automatically picked up when running: docker-compose up
COMPOSE_PROJECT_NAME=tfgen

# ── WebSocket security (Terraform Language Server sessions) ──────────────────
# See CHANGELOG_SECURITY_AUDIT_FIXES.md #4 — caps on concurrent authenticated
# terraform-ls sessions to prevent resource-exhaustion. Safe defaults below;
# override only if you have a real reason to.
MAX_LSP_SESSIONS_PER_USER=2
MAX_LSP_SESSIONS_GLOBAL=50
TF_LSP_IDLE_TIMEOUT_MS=1200000
