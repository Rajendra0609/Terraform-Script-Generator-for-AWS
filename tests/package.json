{
  "name": "tfgen-test-suite",
  "version": "1.0.0",
  "description": "Full test suite for Terraform Script Generator — Unit, Integration, API, E2E, Performance & Security, Smoke",
  "private": true,
  "scripts": {
    "test:unit":        "jest --config jest.unit.config.js --forceExit",
    "test:integration": "jest --config jest.integration.config.js --forceExit --runInBand",
    "test:api":         "jest --config jest.api.config.js --forceExit --runInBand",
    "test:e2e":         "playwright test --config e2e/playwright.config.js",
    "test:smoke":       "jest --config jest.smoke.config.js --forceExit",
    "test:security":    "jest --config jest.security.config.js --forceExit --runInBand",
    "test:performance": "k6 run performance/k6-load.js",
    "test:all":         "npm run test:unit && npm run test:integration && npm run test:api && npm run test:smoke"
  },
  "dependencies": {},
  "devDependencies": {
    "jest":                   "^29.7.0",
    "supertest":              "^6.3.4",
    "axios":                  "^1.6.0",
    "@playwright/test":       "^1.43.0",
    "pg":                     "^8.11.3",
    "bcryptjs":               "^2.4.3",
    "jsonwebtoken":           "^9.0.2",
    "dotenv":                 "^16.3.1",
    "jest-html-reporters":    "^3.1.7",
    "jest-junit":             "^16.0.0",
    "express":                "^4.18.2",
    "cookie-parser":          "^1.4.6"
  }
}
