CORS_ORIGIN=http://localhost:3000, http://10.244.24.67:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_TRUSTED_IPS=127.0.0.1,::1,10.244.24.67
TRUST_PROXY=1

# ── AWS STS credential verification ───────────────────────────────────────────
# This backend cannot reach sts.amazonaws.com — uncomment ONE of the lines below.
#
# Option A: skip STS verification for air-gapped / K8s-internal deployments
SKIP_STS_VERIFY=true
#
# Option B: use an AWS VPC Interface Endpoint for STS
# AWS_STS_ENDPOINT=https://vpce-xxxxxxxxxxxx-xxxxxxxx.sts.ap-south-1.vpce.amazonaws.com
TF_DOCKER_IMAGE=hashicorp/terraform:1.15
# Path to terraform-ls binary — set this to enable full LSP features in Terraform Studio
# Download from: https://releases.hashicorp.com/terraform-ls/
# Linux: sudo apt install terraform-ls  |  macOS: brew install hashicorp/tap/terraform-ls
TF_LSP_PATH=/usr/local/bin/terraform-ls
FRONTEND_URL=http://localhost:3000   # or your production URL

