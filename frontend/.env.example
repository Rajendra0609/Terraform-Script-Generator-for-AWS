# Point to your backend.
# Local dev:      http://localhost:4000
# Docker Compose: http://localhost:4000   (backend port is exposed to host)
# Production:     https://api.yourdomain.com
REACT_APP_API_URL=http://localhost:4000
# LSP WebSocket URL — set to the same value as REACT_APP_API_URL.
# Required for Terraform Studio LSP features (terraform-ls completions, hover, diagnostics).
# Without this, Studio falls back to ws://localhost:4000 regardless of REACT_APP_API_URL.
REACT_APP_API_URL_LS=http://localhost:4000
