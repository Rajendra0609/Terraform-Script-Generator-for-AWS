REACT_APP_API_URL=http://10.244.24.67:4000
# BUG-1 fix: LSP WebSocket URL — must match REACT_APP_API_URL host.
# Without this, the LSP WebSocket defaults to ws://localhost:4000 and
# terraform-ls fails to connect when the backend is on a different host.
REACT_APP_API_URL_LS=http://10.244.24.67:4000
REACT_APP_APP_VERSION=v0.0.1
REACT_APP_APP_ENV=Testing

