# ── API URL ───────────────────────────────────────────────────────────────────
# When running behind the nginx proxy (docker-compose), leave these EMPTY.
# The browser calls /api/... on the same origin and nginx forwards it to
# the backend container using Docker internal DNS (http://backend:4000).
#
# Only set these if you are running the frontend WITHOUT the nginx proxy
# (e.g. bare `npm start` in dev pointing at a separate backend):
#   REACT_APP_API_URL=http://localhost:4000
#   REACT_APP_API_URL_LS=http://localhost:4000
REACT_APP_API_URL=
REACT_APP_API_URL_LS=
 
# ── App metadata ──────────────────────────────────────────────────────────────
REACT_APP_APP_VERSION=v0.0.1
REACT_APP_APP_ENV=Production
